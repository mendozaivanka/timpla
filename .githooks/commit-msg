#!/bin/sh
# Rejects AI attribution in commit messages (co-author trailers, "Generated with" lines).
# Enable once per clone: git config core.hooksPath .githooks
if grep -qiE '^co-authored-by:.*(claude|anthropic|openai|copilot|gpt)|generated with \[?claude|noreply@anthropic\.com' "$1"; then
  echo "commit-msg: remove the AI attribution line from this commit message." >&2
  exit 1
fi
