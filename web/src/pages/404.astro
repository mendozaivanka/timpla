---
import TimplaLayout from "@/components/timpla/TimplaLayout.astro";
---

<TimplaLayout title="Page not found">
  <section class="grid gap-4 py-16">
    <p class="label-mono">404</p>
    <h1 class="text-4xl font-semibold tracking-tight">This page isn't on the menu.</h1>
    <p class="max-w-[52ch] text-muted-foreground">
      The link may be old. Try the <a class="text-primary-strong underline underline-offset-4" href="/timpla/">overview</a>, the
      <a class="text-primary-strong underline underline-offset-4" href="/timpla/map/">café map</a>, or go back to
      <a class="text-primary-strong underline underline-offset-4" href="/">Ivanka's portfolio</a>.
    </p>
  </section>
</TimplaLayout>
