---
// Static map of Metro Manila, rendered at build time in the same style as Sinturon's maps: a flat city outline and
// translucent circles with a thin outline.
// - Overview (no `highlight`): cafés grouped into ~500 m cells, one circle per kind of café per cell, its area
//   growing with the number of cafés. Specialty cafés in rose, the wider directory of independents in fjord blue.
// - With `highlight`: every other café as a small faint circle, the highlighted café's branches in rose with a ring.
// Hovering a circle shows what it stands for (SVG <title>).
import { getIndependents, getNcr, getPoints } from "@/lib/data";
import type { Point } from "@/lib/data/schemas";

type Props = { highlight?: string; class?: string; label?: string };
const { highlight, class: cls = "", label } = Astro.props;
const [ncr, points, independents] = await Promise.all([getNcr(), getPoints(), getIndependents()]);
const { box } = ncr;
const W = box.w, H = box.h;
const project = (lon: number, lat: number): [number, number] => [
  ((lon - box.lon0) / (box.lon1 - box.lon0)) * W,
  ((box.lat1 - lat) / (box.lat1 - box.lat0)) * H,
];

type Kind = "acclaimed" | "recognised" | "independent";
const COLOR: Record<Kind, string> = { acclaimed: "var(--tier-acclaimed)", recognised: "var(--tier-recognised)", independent: "var(--independent)" };
const NAME: Record<Kind, string> = { acclaimed: "acclaimed", recognised: "recognised", independent: "independent" };

const branchLine = (p: Point) => p.name + (p.branch ? ` · ${p.branch}` : "");

// ───────── Overview: grouped circles ─────────
const CELL = 7; // map units; the 300-unit-wide box spans ~22.6 km, so a cell is ~500 m
type Group = { kind: Kind; n: number; x: number; y: number; names: string[] };
const groups = new Map<string, Group>();
const add = (kind: Kind, xy: [number, number], name: string) => {
  const key = `${kind}:${Math.floor(xy[0] / CELL)}:${Math.floor(xy[1] / CELL)}`;
  const g = groups.get(key) ?? { kind, n: 0, x: 0, y: 0, names: [] };
  g.n++; g.x += xy[0]; g.y += xy[1]; g.names.push(name);
  groups.set(key, g);
};
if (!highlight) {
  for (const p of points) add(p.tier === "acclaimed" ? "acclaimed" : "recognised", p.xy as [number, number], branchLine(p));
  for (const c of independents) if (c.cls === "independent") add("independent", project(c.lon, c.lat), c.name);
}
const top = Math.max(1, ...[...groups.values()].map((g) => g.n));
const circles = [...groups.values()]
  .map((g) => ({ ...g, x: g.x / g.n, y: g.y / g.n, r: Math.max(2, 9 * Math.sqrt(g.n / top)) }))
  .sort((a, b) => b.r - a.r);
const title = (g: Group) =>
  `${g.n} ${NAME[g.kind]} ${g.n === 1 ? "café" : "cafés"}\n` + g.names.slice(0, 4).join("\n") + (g.names.length > 4 ? `\n+${g.names.length - 4} more` : "");

// ───────── Highlight: one café's branches ─────────
const mine = highlight ? points.filter((p) => p.slug === highlight) : [];
const rest = highlight ? points.filter((p) => p.slug !== highlight) : [];
const where = (p: Point) => [p.nb, p.city].filter((x, i, a) => x && a.indexOf(x) === i).join(", ");
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class={`block h-auto w-full ${cls}`}
  role="img"
  aria-label={label ?? `Map of Metro Manila with ${points.length} specialty café branches and ${independents.length} other independents, grouped into circles; most cluster in Makati, Taguig and Quezon City.`}
>
  <path d={ncr.path} fill="var(--muted)" stroke="none"></path>
  {
    !highlight &&
      circles.map((g) => (
        <circle cx={g.x} cy={g.y} r={g.r} fill={COLOR[g.kind]} fill-opacity="0.35" stroke={COLOR[g.kind]} stroke-opacity="0.9" stroke-width="0.7" class="cursor-help">
          <title>{title(g)}</title>
        </circle>
      ))
  }
  {
    rest.map((p) => (
      <circle cx={p.xy[0]} cy={p.xy[1]} r="2.2" fill="var(--muted-foreground)" fill-opacity="0.25" stroke="var(--muted-foreground)" stroke-opacity="0.45" stroke-width="0.5">
        <title>{branchLine(p)}</title>
      </circle>
    ))
  }
  {
    mine.map((p) => (
      <g class="cursor-help">
        <title>{`${branchLine(p)}\n${where(p)}${p.since ? `\nsince ${p.since}` : ""}`}</title>
        <circle cx={p.xy[0]} cy={p.xy[1]} r="10" fill="none" stroke="var(--foreground)" stroke-width="1"></circle>
        <circle cx={p.xy[0]} cy={p.xy[1]} r="6" fill="var(--tier-acclaimed)" fill-opacity="0.35" stroke="var(--tier-acclaimed)" stroke-width="1"></circle>
      </g>
    ))
  }
</svg>
