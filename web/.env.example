# Copy to .env for local overrides (.env is git-ignored). Everything is optional; the defaults build the live site.
SITE_URL=https://mendozaivanka.github.io
BASE_PATH=/timpla
# local = the JSON unpacked from the pinned data release (npm run data:pull). http = a JSON API.
DATA_SOURCE=local
DATA_API_URL=
DATA_API_TOKEN=
